:{$PORT:80} {
	# Answerable is the single upstream for everything: its own
	# discovery/booking routes, and the provider's site (served or
	# reverse-proxied by Answerable itself via -site-dir/-upstream), which
	# gets agent-discovery <link> tags injected into every HTML page. Caddy
	# here only terminates the dynamic $PORT Railway assigns.
	reverse_proxy localhost:{$ANSWERABLE_PORT:8081}
}
